pipeline {
    agent {
        docker {
            image 'dydko/maven-playwright:latest'
            args '-v /var/lib/jenkins/.m2:/home/jenkins/.m2'
        }
    }

    tools {
        jdk 'JDK_21'
        maven 'Maven_3.9'
        allure 'allure'
    }

    environment {
        JAVA_HOME = "/usr/lib/jvm/java-21-openjdk-amd64"
        PATH = "$JAVA_HOME/bin:$PATH"
        MAVEN_OPTS = "-Dmaven.test.failure.ignore=false"
        ALLURE_RESULTS_DIR = "target/allure-results"
        ALLURE_REPORT_DIR  = "target/allure-report"
    }

    stages {
        stage('Checkout') {
            steps {
                echo "📦 Checking out branch: ${env.BRANCH_NAME}"
                checkout scm
            }
        }

        stage('Build & Test in Docker') {
            steps {
                echo "⚙️ Running Playwright tests inside Docker..."
                sh 'mvn clean test -Dheadless=true -DrecordVideo=true || true'
            }
        }

        stage('Generate Allure Report') {
            steps {
                echo "📊 Generating Allure report..."
                sh '''
                    if [ -d "${ALLURE_RESULTS_DIR}" ]; then
                        mvn allure:report
                    else
                        echo "⚠️ No allure-results found, skipping report generation."
                    fi
                '''
            }
        }

        stage('Publish Allure Report') {
            steps {
                echo "🌐 Publishing Allure report..."
                allure includeProperties: false, jdk: 'JDK_21', results: [[path: "target/allure-results"]]
            }
        }
    }

    post {
        always {
            echo "🧹 Cleaning up workspace..."
            cleanWs()
        }
        success {
            echo "✅ Build succeeded!"
        }
        failure {
            echo "❌ Build failed!"
        }
    }
}
