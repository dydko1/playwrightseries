pipeline {
  agent {
    docker {
      image 'dydko/maven-playwright:latest'
      reuseNode true
      args '-u 121:125 ' +
           '-v $JENKINS_HOME/.m2:/home/jenkins/.m2 ' +
           '-v $JENKINS_HOME/tools:/var/lib/jenkins/tools'
    }
  }

  options {
    skipDefaultCheckout(true)
    timestamps()
  }

  environment {
    JAVA_HOME = '/opt/java/openjdk'
    PATH = "${JAVA_HOME}/bin:/usr/share/maven/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
    MAVEN_CONFIG = '/home/jenkins/.m2'
    // >>> najważniejsze: lokalny, zapisywalny katalog na przeglądarki
    PLAYWRIGHT_BROWSERS_PATH = "${WORKSPACE}/.ms-playwright"
  }

  stages {
    stage('Checkout') {
      steps { checkout scm }
    }

    stage('Prepare browsers') {
      steps {
        sh '''
          set -eux
          mkdir -p "$PLAYWRIGHT_BROWSERS_PATH"
          echo "📥 Installing Playwright browsers into: $PLAYWRIGHT_BROWSERS_PATH"
          mvn -q org.codehaus.mojo:exec-maven-plugin:3.1.0:java \
            -Dexec.mainClass=com.microsoft.playwright.CLI \
            -Dexec.args="install" \
            -Dexec.classpathScope=test
          ls -la "$PLAYWRIGHT_BROWSERS_PATH" || true
        '''
      }
    }

    stage('Build & Test') {
      steps {
        echo '⚙️ Running Playwright tests inside Docker...'
        sh 'java -version && mvn -v'
        sh 'node -v && npx playwright --version || true'  // tylko podgląd wersji Node PW
        sh 'mvn -B clean test -Dheadless=true -DrecordVideo=true'
      }
      post {
        always {
          junit skipPublishingChecks: true, testResults: 'target/surefire-reports/*.xml'
          archiveArtifacts artifacts: 'target/allure-results/**', allowEmptyArchive: true
        }
      }
    }

    stage('Publish Allure Report') {
      when { expression { fileExists('target/allure-results') } }
      steps {
        echo '🌐 Publishing Allure report...'
        allure includeProperties: false, jdk: '', results: [[path: 'target/allure-results']]
      }
    }
  }

  post {
    always {
      echo '🧹 Cleaning workspace...'
      cleanWs()
    }
  }
}
