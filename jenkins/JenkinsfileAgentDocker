pipeline {
    agent {
        docker {
            image 'maven:3.9.9-eclipse-temurin-21'
            // Użyj lokalnego cache Mavena i dostęp do socka Dockera
            args '-u root -v /var/lib/jenkins/.m2:/root/.m2 -v /var/run/docker.sock:/var/run/docker.sock'
        }
    }

    tools {
        allure 'allure' // 👈 nazwa z konfiguracji w Jenkins → Global Tool Configuration
    }

    environment {
        MAVEN_OPTS = "-Dmaven.test.failure.ignore=false"
        ALLURE_RESULTS_DIR = "target/allure-results"
        ALLURE_REPORT_DIR = "target/allure-report"
    }

    stages {

        stage('Checkout') {
            steps {
                echo "📦 Checking out branch: ${env.BRANCH_NAME}"
                checkout scm
            }
        }

    stage('Install Playwright Deps') {
        steps {
            echo "🧩 Installing missing Playwright dependencies..."
            sh '''
                apt-get update
                apt-get install -y --no-install-recommends \
                    libglib2.0-0 libnss3 libnspr4 libdbus-1-3 libatk1.0-0 \
                    libatk-bridge2.0-0 libcups2 libdrm2 libxcb1 libxkbcommon0 \
                    libatspi2.0-0 libx11-6 libxcomposite1 libxdamage1 libxext6 \
                    libxfixes3 libxrandr2 libgbm1 libpango-1.0-0 libcairo2 \
                    libasound2t64 libxshmfence1 libx11-xcb1 libxcursor1 libxi6 \
                    libgtk-3-0 libgdk-pixbuf2.0-0 libxrender1 libdbus-glib-1-2
            '''
        }
    }

        stage('Build & Test') {
            steps {
                echo "⚙️ Running Maven tests inside Docker..."
                sh 'mvn clean test -Dheadless=true -DrecordVideo=true'
            }
        }

        stage('Generate Allure Report') {
            steps {
                echo "📊 Generating Allure report..."
                sh '''
                    if [ -d "${ALLURE_RESULTS_DIR}" ]; then
                        mvn allure:report
                    else
                        echo "⚠️ No allure-results directory found!"
                    fi
                '''
            }
        }

        stage('Archive Results') {
            steps {
                echo "📦 Archiving reports and logs..."
                archiveArtifacts artifacts: 'target/allure-results/**', allowEmptyArchive: true
                archiveArtifacts artifacts: 'target/allure-report/**', allowEmptyArchive: true
            }
        }

        stage('Publish Allure Report') {
            steps {
                echo "🌐 Publishing Allure report in Jenkins..."
                allure includeProperties: false,
                       jdk: '',
                       results: [[path: "target/allure-results"]]
            }
        }
    }

    post {
        always {
            echo "🧹 Cleaning up workspace..."
            cleanWs()
        }
        success {
            echo "✅ Build succeeded!"
        }
        failure {
            echo "❌ Build failed!"
        }
    }
}
