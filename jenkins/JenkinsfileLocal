pipeline {
    agent {
        docker {
            image 'maven:3.9.9-eclipse-temurin-21'
            args '-v /var/run/docker.sock:/var/run/docker.sock'
        }
    }

    environment {
        MAVEN_OPTS = "-Dmaven.test.failure.ignore=false"
        ALLURE_RESULTS_DIR = "target/allure-results"
        ALLURE_REPORT_DIR = "target/allure-report"
    }

    stages {
        stage('Checkout') {
            steps {
                echo "📦 Checking out branch: ${env.BRANCH_NAME}"
                checkout scm
            }
        }

        stage('Build & Test') {
            steps {
                echo "⚙️ Running Maven tests inside Docker..."
                sh 'mvn clean test -Dheadless=true -DrecordVideo=false'
            }
        }

        stage('Generate Allure Report') {
            steps {
                echo "📊 Generating Allure report..."
                sh '''
                    if [ -d "${ALLURE_RESULTS_DIR}" ]; then
                        mvn allure:report
                    else
                        echo "⚠️ No allure-results directory found!"
                    fi
                '''
            }
        }

        stage('Archive Results') {
            steps {
                echo "📦 Archiving reports and logs..."
                archiveArtifacts artifacts: 'target/allure-results/**', allowEmptyArchive: true
                archiveArtifacts artifacts: 'target/allure-report/**', allowEmptyArchive: true
            }
        }
    }

    post {
        always {
            echo "🧹 Cleaning up workspace..."
            cleanWs()
        }
        success {
            echo "✅ Build succeeded!"
        }
        failure {
            echo "❌ Build failed!"
        }
    }
}
