# ===== BASE =====
FROM maven:3.9.9-eclipse-temurin-21

ARG UID=121
ARG GID=125
ARG USER=jenkins

# Użytkownik Jenkins (dla zgodności z Jenkins pipeline -u 121:125)
RUN groupadd -g ${GID} ${USER} && useradd -m -u ${UID} -g ${GID} ${USER}

ENV JAVA_HOME=/opt/java/openjdk
ENV PATH="${JAVA_HOME}/bin:/usr/share/maven/bin:${PATH}"
ENV MAVEN_CONFIG=/home/${USER}/.m2
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

# ===== DEPS =====
RUN apt-get update && apt-get install -y --no-install-recommends \
      curl ca-certificates gnupg unzip wget git \
      libglib2.0-0 libnss3 libnspr4 libdbus-1-3 libatk1.0-0 \
      libatk-bridge2.0-0 libcups2 libdrm2 libxkbcommon0 \
      libx11-6 libxcomposite1 libxdamage1 libxext6 libxfixes3 \
      libxrandr2 libgbm1 libpango-1.0-0 libcairo2 \
      libxshmfence1 libx11-xcb1 libxrender1 libasound2t64 \
      libgtk-3-0 libgdk-pixbuf2.0-0 \
 && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
 && apt-get install -y --no-install-recommends nodejs \
 && apt-get clean && rm -rf /var/lib/apt/lists/*

# ===== PLAYWRIGHT + BROWSERS =====
RUN mkdir -p /ms-playwright /home/${USER}/.m2 && chown -R ${USER}:${USER} /ms-playwright /home/${USER}

# Instalacja Playwrighta i przeglądarek (Chromium, Firefox, WebKit)
RUN npx --yes playwright install --with-deps && chown -R jenkins:jenkins /ms-playwright

USER ${USER}
WORKDIR /home/${USER}/app
