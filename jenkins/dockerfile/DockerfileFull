# ===== BASE =====
FROM maven:3.9.9-eclipse-temurin-21

ARG UID=121
ARG GID=125
ARG USER=jenkins

# Użytkownik Jenkins (zgodny z -u 121:125 w pipeline)
RUN groupadd -g ${GID} ${USER} && useradd -m -u ${UID} -g ${GID} ${USER}

ENV JAVA_HOME=/opt/java/openjdk
ENV MAVEN_CONFIG=/home/${USER}/.m2
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
ENV PWDEBUG=0

# System deps potrzebne dla przeglądarek
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl git unzip xvfb \
    libnss3 libatk1.0-0 libatk-bridge2.0-0 libcups2 libdbus-1-3 libdrm2 \
    libxkbcommon0 libatspi2.0-0 libxshmfence1 libgbm1 libgtk-3-0 \
    libasound2 fonts-liberation libcurl4 \
 && rm -rf /var/lib/apt/lists/*

# Node.js 20 (przydaje się do narzędzi i npx playwright --version)
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
 && apt-get update && apt-get install -y --no-install-recommends nodejs \
 && rm -rf /var/lib/apt/lists/*

# Preinstalacja przeglądarek Playwright (Node) do współdzielonej ścieżki
# (Java Playwright i tak pobierze swoje binaria jeśli będą potrzebne,
# ale ten cache często wystarcza)
RUN mkdir -p ${PLAYWRIGHT_BROWSERS_PATH} \
 && npx --yes playwright@1.56.1 install --with-deps chromium firefox webkit \
 && chown -R ${USER}:${USER} ${PLAYWRIGHT_BROWSERS_PATH}

USER ${USER}
WORKDIR /workspace

CMD ["bash"]
