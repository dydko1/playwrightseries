# ==============================
# 🧱 DockerfileFull — Playwright + Maven + Node + Allure + Jenkins user
# ==============================

# Bazowy obraz: Playwright z JDK 21 i przeglądarkami (stabilny, nie nightly)
FROM mcr.microsoft.com/playwright/java:v1.55.0-jammy

# Ustawienia środowiska
ENV LANG=en_US.UTF-8 \
    LANGUAGE=en_US:en \
    LC_ALL=en_US.UTF-8 \
    DEBIAN_FRONTEND=noninteractive

# Aktualizacja systemu i instalacja narzędzi systemowych
RUN apt-get update && apt-get install -y \
    wget curl git unzip sudo locales tzdata \
 && locale-gen en_US.UTF-8 \
 && update-locale LANG=en_US.UTF-8 \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/*

# Instalacja Maven + Node + Allure CLI (manualnie, bez sudo)
RUN apt-get update && apt-get install -y maven nodejs npm \
 && npm install -g allure-commandline --force \
 && apt-get clean && rm -rf /var/lib/apt/lists/*

# Tworzenie użytkownika Jenkins i katalogów roboczych
RUN groupadd -g 125 jenkins && \
    useradd -m -u 121 -g 125 jenkins && \
    mkdir -p /home/jenkins/.m2 /home/jenkins/app /ms-playwright && \
    chown -R jenkins:jenkins /home/jenkins /ms-playwright

# Instalacja przeglądarek Playwright (Chrome, Firefox, WebKit)
RUN npx --yes playwright install --with-deps

# Przełączenie na użytkownika Jenkins
USER jenkins

# Katalog roboczy
WORKDIR /home/jenkins/app

# Domyślna komenda
CMD ["bash"]
