# ==============================
# DockerfileFull — Playwright + Maven + Node + Allure + Jenkins user
# ==============================

# Bazowy obraz Microsoft Playwright (z JDK i browser deps)
FROM mcr.microsoft.com/playwright/java:v1.55.0-jammy

# Locale i środowisko
ENV LANG=en_US.UTF-8 \
    LANGUAGE=en_US:en \
    LC_ALL=en_US.UTF-8 \
    DEBIAN_FRONTEND=noninteractive

# Aktualizacja systemu i instalacja narzędzi
RUN apt-get update && apt-get install -y \
    wget curl git unzip sudo locales tzdata ca-certificates gnupg \
 && locale-gen en_US.UTF-8 \
 && update-locale LANG=en_US.UTF-8

# =======================================================
# 🧩 Instalacja Node.js 20 + NPM + Maven + Allure
# =======================================================
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
 && apt-get install -y nodejs maven \
 && npm install -g allure-commandline@2.29.0 --force \
 && node -v && npm -v && mvn -v

# =======================================================
# 🧩 Tworzenie użytkownika Jenkins i katalogów roboczych
# =======================================================
RUN groupadd -g 125 jenkins && \
    useradd -m -u 121 -g 125 jenkins && \
    mkdir -p /home/jenkins/.m2 /home/jenkins/app /ms-playwright && \
    chown -R jenkins:jenkins /home/jenkins /ms-playwright

# =======================================================
# 🧩 Instalacja przeglądarek Playwright (Chrome, Firefox, WebKit)
# =======================================================
RUN npx --yes playwright install --with-deps

# =======================================================
# 🧩 Użytkownik Jenkins i katalog roboczy
# =======================================================
USER jenkins
WORKDIR /home/jenkins/app

CMD ["bash"]
