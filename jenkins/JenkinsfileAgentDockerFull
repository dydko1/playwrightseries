pipeline {
  agent {
    docker {
      image 'dydko/maven-playwright:full'
      reuseNode true
      args '-u 121:125'
    }
  }

  options {
    timestamps()
    skipDefaultCheckout(true)
  }

  environment {
    JAVA_HOME = '/opt/java/openjdk'
    PATH = "${JAVA_HOME}/bin:/usr/share/maven/bin:/usr/local/bin:/usr/bin:/bin"
    MAVEN_CONFIG = '/home/jenkins/.m2'
    PLAYWRIGHT_BROWSERS_PATH = '/ms-playwright'
  }

  stages {
    stage('Checkout') {
      steps {
        echo '📦 Checking out repository...'
        checkout scm
      }
    }

    stage('Build & Test') {
      steps {
        echo '🚀 Running Playwright tests (browsers preinstalled)...'
        sh '''
          set -eux
          java -version
          mvn -v
          node -v
          npx playwright --version
          mvn -B clean test -Dheadless=true -DrecordVideo=true -Pci
        '''
      }
      post {
        always {
          junit testResults: 'target/surefire-reports/*.xml', skipPublishingChecks: true
          archiveArtifacts artifacts: 'target/allure-results/**', allowEmptyArchive: true
        }
      }
    }

    stage('Allure Report') {
      when {
        expression { fileExists('target/allure-results') }
      }
      steps {
        echo '📊 Generating Allure report...'
        allure includeProperties: false, jdk: '', results: [[path: 'target/allure-results']]
      }
    }
  }

  post {
    always {
      echo '🧹 Cleaning workspace...'
      cleanWs()
    }
    success {
      echo '✅ Build finished successfully!'
    }
    failure {
      echo '❌ Build failed. Check test reports or logs.'
    }
  }
}
