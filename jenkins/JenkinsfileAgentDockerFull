pipeline {
    agent any

    environment {
        IMAGE = 'dydko/maven-playwright:full'
    }

    stages {
        stage('Checkout') {
            steps {
                timestamps {
                    checkout scm
                }
            }
        }

        stage('Build & Test') {
            steps {
                timestamps {
                    echo '🚀 Running Playwright tests (browsers preinstalled)...'
                    script {
                        docker.image("${IMAGE}").inside("-u 121:125") {
                            sh 'java -version'
                            sh 'mvn -v'
                            sh 'node -v'
                            sh 'npx playwright --version'
                            sh 'mvn -B clean test -Dheadless=true -DrecordVideo=true -Pci'
                        }
                    }
                }
            }
        }

        stage('Allure Report') {
            when { expression { currentBuild.resultIsBetterOrEqualTo('SUCCESS') } }
            steps {
                echo '📊 Generating Allure report...'
                allure includeProperties: false,
                       jdk: '',
                       results: [[path: 'target/allure-results']]
            }
        }
    }

    post {
        always {
            echo '🧹 Cleaning workspace...'
            cleanWs()
        }
        success {
            echo '✅ Build finished successfully!'
        }
        failure {
            echo '❌ Build failed. Check test reports or logs.'
        }
    }
}
