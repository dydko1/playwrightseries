pipeline {
    agent {
        docker {
            image 'dydko/maven-playwright:full'
            args '-u root:root'
        }
    }

    stages {
        stage('Checkout') {
            steps {
                echo "📦 Checking out repository..."
                checkout scm
            }
        }

        stage('Build & Test') {
            steps {
                echo "🚀 Running Playwright tests (browsers preinstalled)..."
                sh '''
                    set -eux
                    java -version
                    mvn -v
                    node -v
                    npx playwright --version
                    mvn -B clean test -Dheadless=true -DrecordVideo=true -Pci
                '''
            }
        }

        stage('Allure Report') {
            steps {
                echo "📊 Generating Allure report..."
                sh '''
                    allure generate target/allure-results -c -o allure-report || true
                '''
                allure([
                    includeProperties: false,
                    jdk: '',
                    results: [[path: 'target/allure-results']],
                    reportBuildPolicy: 'ALWAYS'
                ])
            }
        }
    }

    post {
        always {
            echo "🧹 Cleaning workspace..."
            cleanWs()
        }
        failure {
            echo "❌ Build failed. Check test reports or logs."
        }
    }
}
