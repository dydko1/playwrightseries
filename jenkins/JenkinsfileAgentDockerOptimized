pipeline {
  agent {
    docker {
      image 'dydko/maven-playwright:latest'
      reuseNode true
      args '-u 121:125 ' +
           '-v $JENKINS_HOME/.m2:/home/jenkins/.m2 ' +
           '-v $JENKINS_HOME/tools:/var/lib/jenkins/tools ' +
           '-v $JENKINS_HOME/ms-playwright:/ms-playwright'
    }
  }

  options { timestamps(); skipDefaultCheckout(true) }

  environment {
    JAVA_HOME = '/opt/java/openjdk'
    PATH = "${JAVA_HOME}/bin:/usr/share/maven/bin:/usr/local/bin:/usr/bin:/bin"
    MAVEN_CONFIG = '/home/jenkins/.m2'
    PLAYWRIGHT_BROWSERS_PATH = '/ms-playwright'
  }

  stages {
    stage('Checkout') {
      steps { checkout scm }
    }

    stage('Prepare browsers') {
      steps {
        sh '''
          set -eux
          if [ ! -d "$PLAYWRIGHT_BROWSERS_PATH/chromium" ]; then
            echo "📥 Installing Playwright browsers..."
            mvn -q org.codehaus.mojo:exec-maven-plugin:3.1.0:java \
              -Dexec.mainClass=com.microsoft.playwright.CLI \
              -Dexec.args="install" \
              -Dexec.classpathScope=test
          else
            echo "✅ Browsers already cached."
          fi
        '''
      }
    }

    stage('Build & Test') {
      steps {
        sh 'java -version && mvn -v'
        sh 'node -v && npx playwright --version || true'
        sh 'mvn -B clean test -Dheadless=true -DrecordVideo=true -Pci'
      }
      post {
        always {
          junit testResults: 'target/surefire-reports/*.xml', skipPublishingChecks: true
          archiveArtifacts artifacts: 'target/allure-results/**', allowEmptyArchive: true
        }
      }
    }

    stage('Allure Report') {
      when { expression { fileExists('target/allure-results') } }
      steps {
        echo '📊 Publishing Allure Report...'
        allure includeProperties: false, jdk: '', results: [[path: 'target/allure-results']]
      }
    }
  }

  post {
    always {
      echo '🧹 Cleaning workspace...'
      cleanWs()
    }
  }
}
